{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "jest --config jest.config.json --runInBand",
    "test:e2e": "jest --config jest.config.json --runInBand --runTestsByPath tests/concurrency.spec.ts",
    "migration:up": "mikro-orm migration:up --config src/mikro-orm.config.ts",
    "migration:down": "mikro-orm migration:down --config src/mikro-orm.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.800.0",
    "@mikro-orm/core": "^6.4.16",
    "@mikro-orm/migrations": "^6.4.16",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.4.16",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/schedule": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.7",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.4.16",
    "@nestjs/cli": "^11.0.24",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "multer": "^2.5.0",
    "@rushstack/node-core-library": "^5.25.1",
    "@rushstack/node-core-library@^5.25.1": {
      "ajv": "^8.20.0"
    }
  }
